<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>PathOfBuilding-PoE2</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundleIdentifier</key>
  <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
  <key>CFBundleName</key>
  <string>Path of Building (PoE2)</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.23.1</string>
  <!-- pob2:// protocol handler ("Open in PoB" links on pobb.in / poe.ninja).
       The dev build registers the scheme too (distinct CFBundleURLName via the
       -dev bundle id), but macOS routes each pob2:// open to a single default
       handler app; see docs/macos.md. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>CFBundleURLName</key>
      <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}.pob2</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>pob2</string>
      </array>
    </dict>
  </array>
  <key>CFBundleVersion</key>
  <string>15</string>
  <!-- Placeholder only: package_app.sh overwrites this with the value measured
       from the finished bundle (the highest minos across the host binary and the
       bundled libraries). See docs/macos.md#minimum-macos-version. -->
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>

